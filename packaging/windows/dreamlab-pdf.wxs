<?xml version="1.0" encoding="utf-8"?>
<!--
  DreamLab PDF MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build dreamlab-pdf.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d ModelsDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, a desktop shortcut (on by default,
  optional), an App Paths entry, and DreamLab PDF registered as a PDF handler (offered under "Open with"
  and in Default apps, never forced as the default). Files opened with DreamLab PDF arrive on its
  command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="DreamLab PDF"
      Manufacturer="DreamLab"
      Version="$(var.Version)"
      UpgradeCode="51D5EF44-D980-4328-878E-A636B57111D8"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="DreamLab PDF workbench" Manufacturer="DreamLab" />
    <!-- HKLM registrations must never point into a per-user installation (#305). Allow removal
         of an existing installation even if an older MSI let it install per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="DreamLab PDF must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of DreamLab PDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="DreamlabPdfIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DreamlabPdfIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mad10188/dreamlab-pdf" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/mad10188/dreamlab-pdf" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mad10188/dreamlab-pdf/issues" />
    <!-- Desktop shortcut (#143): on by default, a checkbox in the full-UI welcome dialog, and
         INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended installs. Secure, so the
         choice made in the (unelevated) UI reaches the elevated install. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <UIRef Id="DreamlabPdfInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DreamLab PDF">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="DreamLab PDF" Level="1">
      <ComponentGroupRef Id="DreamlabPdfFiles" />
      <ComponentGroupRef Id="DreamlabPdfModels" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DreamlabPdfFiles" Directory="INSTALLFOLDER">
      <Component Id="DreamlabPdfApp" Guid="73EBE13F-A053-4CB2-93CE-62E9DE4DC5B7">
        <File Id="DreamlabPdfExe" Source="$(var.BinDir)\dreamlab-pdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\dreamlab-pdf.exe" Value="[#DreamlabPdfExe]" Type="string" />

        <!-- PDF files (#107): DreamLab PDF is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             DreamLab PDF entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\DreamLabPDF.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app's lion; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\DreamLabPDF.Document\DefaultIcon" Value="&quot;[#DreamlabPdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\DreamLabPDF.Document\shell\open\command" Value="&quot;[#DreamlabPdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="DreamLabPDF.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-pdf.exe" Name="FriendlyAppName" Value="DreamLab PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-pdf.exe\DefaultIcon" Value="&quot;[#DreamlabPdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-pdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\dreamlab-pdf.exe\shell\open\command" Value="&quot;[#DreamlabPdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\DreamLab PDF\Capabilities" Name="ApplicationName" Value="DreamLab PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\DreamLab PDF\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\DreamLab PDF\Capabilities" Name="ApplicationIcon" Value="[#DreamlabPdfExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\DreamLab PDF\Capabilities\FileAssociations" Name=".pdf" Value="DreamLabPDF.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="DreamLab PDF" Value="Software\DreamLab PDF\Capabilities" Type="string" />

        <!-- Image context menu (#190): convert without changing image file defaults. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\DreamLabPDF.CreatePdf" Value="Create PDF with DreamLab PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\DreamLabPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\DreamLabPDF.CreatePdf\command" Value="&quot;[#DreamlabPdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to dreamlab-pdf.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="DreamlabPdfStartMenuShortcut" Directory="ProgramMenuFolder" Guid="A11CB8C9-1142-46DD-BD8A-FF1E31C343F5">
        <Shortcut Id="StartMenuShortcut" Name="DreamLab PDF" Description="DreamLab PDF workbench"
            Target="[#DreamlabPdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="DreamlabPdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\DreamLab PDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DreamlabPdfDesktopShortcut" Directory="DesktopFolder" Guid="95515CFD-4600-4B65-B48B-075609BADA13"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="DreamLab PDF" Description="DreamLab PDF workbench"
            Target="[#DreamlabPdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="DreamlabPdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\DreamLab PDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DreamlabPdfCli">
        <File Id="DreamlabPdfCliExe" Source="$(var.BinDir)\dreamlab-pdf-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The embedded PDF icon's ISC notice and project licences travel with the binaries. -->
      <Component Id="DreamlabPdfDocumentIconLicense">
        <File Id="DreamlabPdfDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="DreamlabPdfMitLicense">
        <File Id="DreamlabPdfMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="DreamlabPdfApacheLicense">
        <File Id="DreamlabPdfApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="DreamlabPdfNotice">
        <File Id="DreamlabPdfNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside dreamlab-pdf.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. -->
    <ComponentGroup Id="DreamlabPdfModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
